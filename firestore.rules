rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // COMMON FUNCTIONS
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.uid == "RkjeRGOd1xdCNFjVR7bB7GXtmAG2";
    }


    // ============================================================
    // APPROVED VENDOR
    // ============================================================

    function isVendor() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && exists(
          /databases/$(database)/documents/vendors/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "vendor"
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.status == "approved"
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.active == true
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.approvedByAdmin == true
        && get(
          /databases/$(database)/documents/vendors/$(request.auth.uid)
        ).data.role == "vendor"
        && get(
          /databases/$(database)/documents/vendors/$(request.auth.uid)
        ).data.status == "approved"
        && get(
          /databases/$(database)/documents/vendors/$(request.auth.uid)
        ).data.active == true
        && get(
          /databases/$(database)/documents/vendors/$(request.auth.uid)
        ).data.approvedByAdmin == true;
    }


    // ============================================================
    // APPROVED COURIER
    // ============================================================

    function isCourier() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && exists(
          /databases/$(database)/documents/couriers/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "courier"
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.status == "approved"
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.active == true
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.approvedByAdmin == true
        && get(
          /databases/$(database)/documents/couriers/$(request.auth.uid)
        ).data.role == "courier"
        && get(
          /databases/$(database)/documents/couriers/$(request.auth.uid)
        ).data.status == "approved"
        && get(
          /databases/$(database)/documents/couriers/$(request.auth.uid)
        ).data.active == true
        && get(
          /databases/$(database)/documents/couriers/$(request.auth.uid)
        ).data.approvedByAdmin == true;
    }


    // ============================================================
    // PRODUCTS
    // ============================================================

    match /products/{productId} {

      // Public product catalogue
      allow read: if true;

      // Admin full control
      allow create, update, delete: if isAdmin();

      // Approved vendor can create own product
      allow create: if isVendor()
        && request.resource.data.vendorUid == request.auth.uid;

      // Approved vendor can update own product
      allow update: if isVendor()
        && resource.data.vendorUid == request.auth.uid
        && request.resource.data.vendorUid == request.auth.uid;

      // Vendor cannot transfer product ownership
      allow update: if isVendor()
        && resource.data.vendorUid == request.auth.uid
        && request.resource.data.vendorUid != request.auth.uid
        ? false
        : false;

      // ------------------------------------------------------------
      // STOCK
      // ------------------------------------------------------------
      // Any signed-in user may only perform a stock decrease.
      // No price/title/vendor/payment changes are permitted through
      // this rule.
      //
      // IMPORTANT:
      // This is retained for compatibility with existing stock flow.
      // Backend/Admin should be preferred for stock mutations.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['Stock'])
        && request.resource.data.Stock >= 0
        && request.resource.data.Stock <= resource.data.Stock;
    }


    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      // Admin or owner can read own profile
      allow read: if isAdmin()
        || isOwner(userId);


      // ------------------------------------------------------------
      // CUSTOMER REGISTRATION
      // ------------------------------------------------------------

      allow create: if isOwner(userId)
        && (
          !request.resource.data.keys().hasAny(['role'])
          || request.resource.data.role == "customer"
        );


      // ------------------------------------------------------------
      // VENDOR / COURIER REGISTRATION
      // ------------------------------------------------------------

      allow create: if isOwner(userId)
        && request.resource.data.role in ["vendor", "courier"]
        && request.resource.data.status == "pending_documents"
        && request.resource.data.active == false
        && request.resource.data.approvedByAdmin == false;


      // ------------------------------------------------------------
      // ADMIN UPDATE
      // ------------------------------------------------------------

      allow update: if isAdmin();


      // ------------------------------------------------------------
      // OWNER UPDATE
      // ------------------------------------------------------------
      // User can update normal profile fields.
      //
      // SECURITY:
      // role
      // active
      // approval
      // vendorStatus
      // registrationStatus
      //
      // cannot be changed by client.
      // ------------------------------------------------------------

      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasAny([
            'role',
            'active',
            'vendorStatus',
            'approvedByAdmin',
            'registrationStatus'
          ])
        && (
          request.resource.data.status == resource.data.status
          ||
          (
            resource.data.status == "pending_documents"
            && request.resource.data.status == "pending_approval"
          )
          ||
          (
            resource.data.status == "rejected"
            && request.resource.data.status == "pending_approval"
          )
        );


      // Client cannot delete users
      allow delete: if false;


      // ==========================================================
      // ADDRESSES
      // ==========================================================

      match /addresses/{addressId} {

        allow read, create, update, delete: if isAdmin()
          || isOwner(userId);
      }
    }


    // ============================================================
    // VENDORS
    // ============================================================

    match /vendors/{vendorId} {

      // Admin full control
      allow read, write: if isAdmin();


      // Approved vendor can read own profile
      allow read: if isVendor()
        && request.auth.uid == vendorId;


      // Pending/rejected vendor can read own profile
      allow read: if isOwner(vendorId)
        && resource.data.role == "vendor"
        && resource.data.active == false
        && resource.data.status != "approved";


      // ------------------------------------------------------------
      // VENDOR REGISTRATION
      // ------------------------------------------------------------

      allow create: if isOwner(vendorId)
        && request.resource.data.role == "vendor"
        && request.resource.data.status == "pending_documents"
        && request.resource.data.active == false
        && request.resource.data.approvedByAdmin == false;


      // ------------------------------------------------------------
      // VENDOR DOCUMENT UPDATES
      // ------------------------------------------------------------

      allow update: if isOwner(vendorId)
        && resource.data.role == "vendor"
        && resource.data.active == false
        && resource.data.approvedByAdmin == false
        && request.resource.data.role == "vendor"
        && request.resource.data.active == false
        && request.resource.data.approvedByAdmin == false
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'documents',
            'documentsSubmitted',
            'updatedAt',
            'status',
            'registrationType',
            'registrationNo'
          ])
        && (
          request.resource.data.status == resource.data.status
          ||
          (
            resource.data.status == "pending_documents"
            && request.resource.data.status == "pending_approval"
            && request.resource.data.documentsSubmitted == true
          )
          ||
          (
            resource.data.status == "rejected"
            && request.resource.data.status == "pending_approval"
            && request.resource.data.documentsSubmitted == true
          )
        );


      allow delete: if false;
    }


    // ============================================================
    // COURIERS
    // ============================================================

    match /couriers/{courierId} {

      // Admin full control
      allow read, write: if isAdmin();


      // Approved courier can read own profile
      allow read: if isCourier()
        && request.auth.uid == courierId;


      // Pending/rejected courier can read own profile
      allow read: if isOwner(courierId)
        && resource.data.role == "courier"
        && resource.data.active == false
        && resource.data.status != "approved";


      // ------------------------------------------------------------
      // COURIER REGISTRATION
      // ------------------------------------------------------------

      allow create: if isOwner(courierId)
        && request.resource.data.role == "courier"
        && request.resource.data.status == "pending_documents"
        && request.resource.data.active == false
        && request.resource.data.approvedByAdmin == false;


      // ------------------------------------------------------------
      // COURIER DOCUMENT UPDATES
      // ------------------------------------------------------------

      allow update: if isOwner(courierId)
        && resource.data.role == "courier"
        && resource.data.active == false
        && resource.data.approvedByAdmin == false
        && request.resource.data.role == "courier"
        && request.resource.data.active == false
        && request.resource.data.approvedByAdmin == false
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'documents',
            'documentsSubmitted',
            'updatedAt',
            'status',
            'registrationType',
            'registrationNo'
          ])
        && (
          request.resource.data.status == resource.data.status
          ||
          (
            resource.data.status == "pending_documents"
            && request.resource.data.status == "pending_approval"
            && request.resource.data.documentsSubmitted == true
          )
          ||
          (
            resource.data.status == "rejected"
            && request.resource.data.status == "pending_approval"
            && request.resource.data.documentsSubmitted == true
          )
        );


      // Courier cannot delete own profile
      allow delete: if false;
    }


    // ============================================================
    // ORDERS
    // ============================================================

    match /orders/{orderId} {

      // ------------------------------------------------------------
      // CREATE ORDER
      // ------------------------------------------------------------
      // Customer can create own order.
      //
      // COD is allowed because paymentMethod is NOT blocked on
      // creation.
      // ------------------------------------------------------------

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;


      // ------------------------------------------------------------
      // READ ORDERS
      // ------------------------------------------------------------

      allow read: if isAdmin()

        ||

        (
          isSignedIn()
          && resource.data.userId == request.auth.uid
        )

        ||

        (
          isVendor()
          && request.auth.uid in resource.data.vendorUids
        )

        ||

        (
          isCourier()
          && resource.data.courierId == request.auth.uid
        );


      // ==========================================================
      // ADMIN ORDER UPDATE
      // ==========================================================

      allow update: if isAdmin()
        && (
          !request.resource.data.keys().hasAny(['courierId'])
          ||
          request.resource.data.courierId == null
          ||
          (
            exists(
              /databases/$(database)/documents/couriers/$(request.resource.data.courierId)
            )
            &&
            get(
              /databases/$(database)/documents/couriers/$(request.resource.data.courierId)
            ).data.role == "courier"
            &&
            get(
              /databases/$(database)/documents/couriers/$(request.resource.data.courierId)
            ).data.status == "approved"
            &&
            get(
              /databases/$(database)/documents/couriers/$(request.resource.data.courierId)
            ).data.active == true
            &&
            get(
              /databases/$(database)/documents/couriers/$(request.resource.data.courierId)
            ).data.approvedByAdmin == true

            &&

            exists(
              /databases/$(database)/documents/users/$(request.resource.data.courierId)
            )
            &&
            get(
              /databases/$(database)/documents/users/$(request.resource.data.courierId)
            ).data.role == "courier"
            &&
            get(
              /databases/$(database)/documents/users/$(request.resource.data.courierId)
            ).data.status == "approved"
            &&
            get(
              /databases/$(database)/documents/users/$(request.resource.data.courierId)
            ).data.active == true
            &&
            get(
              /databases/$(database)/documents/users/$(request.resource.data.courierId)
            ).data.approvedByAdmin == true
          )
        );


      // ==========================================================
      // CUSTOMER ORDER UPDATE
      // ==========================================================
      //
      // Customer cannot change:
      // - amount
      // - total
      // - price
      // - payment
      // - COD amount
      // - courier
      // - vendor
      // - order status
      //
      // This protects financial/order integrity.
      //
      // Customer may update only safe customer-side fields.
      // ==========================================================

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'customerName',
            'customerPhone',
            'shippingAddress',
            'deliveryAddress',
            'address',
            'notes',
            'updatedAt'
          ]);


      // ==========================================================
      // VENDOR ORDER UPDATE
      // ==========================================================
      //
      // Vendor cannot modify financial/payment/courier fields.
      //
      // Vendor status changes should preferably go through the
      // secured Cloud Functions.
      // ==========================================================

      allow update: if isVendor()
        && request.auth.uid in resource.data.vendorUids
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.courierId == resource.data.courierId
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'statusHistory',
            'updatedAt'
          ]);


      // ==========================================================
      // COURIER ORDER UPDATE
      // ==========================================================
      //
      // IMPORTANT:
      // Courier MUST NOT directly update orders in Firestore.
      //
      // Courier status is changed through:
      //
      // updateCourierOrderStatus()
      //
      // Cloud Function uses Admin SDK and therefore bypasses these
      // Firestore client rules.
      //
      // This prevents courier from changing:
      // - paymentMethod
      // - paymentStatus
      // - COD amount
      // - total
      // - price
      // - courierId
      // - vendor
      // - customer
      // - order ownership
      // ==========================================================

      allow update: if false;


      // ==========================================================
      // DELETE
      // ==========================================================

      allow delete: if isAdmin();
    }


    // ============================================================
    // ADMIN COLLECTIONS
    // ============================================================

    match /Admins/{adminId} {

      allow read: if isAdmin();

      allow create, update, delete: if false;
    }


    match /admins/{adminId} {

      allow read: if isAdmin();

      allow create, update, delete: if false;
    }


    // ============================================================
    // DEFAULT DENY
    // ============================================================
    //
    // Any collection not explicitly listed above is denied.
    // ============================================================

  }
}
