rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // HELPER FUNCTIONS
    // =========================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }


    // =========================
    // USERS
    // =========================

    match /users/{userId} {

      // Customer अपने profile को देख सकता है.
      // Admin सभी users देख सकता है.
      allow read: if isOwner(userId) || isAdmin();

      // New customer अपना account document बना सकता है.
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == "customer";

      // Customer केवल सामान्य profile fields बदल सकता है.
      // role/status/active/mobileVerified जैसी security fields
      // customer खुद नहीं बदल सकता.
      allow update: if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.active == resource.data.active
          && request.resource.data.mobileVerified == resource.data.mobileVerified
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                "name",
                "email",
                "address",
                "pinCode",
                "updatedAt"
              ])
        );

      // Customer अपना user document delete नहीं कर सकता.
      allow delete: if isAdmin();
    }


    // =========================
    // PRODUCTS
    // =========================

    match /products/{productId} {

      // Shopping app में products देखना public रखा गया है.
      allow read: if true;

      // केवल Admin products manage कर सकता है.
      allow create, update, delete: if isAdmin();
    }


    // =========================
    // CATEGORIES
    // =========================

    match /categories/{categoryId} {

      allow read: if true;

      allow create, update, delete: if isAdmin();
    }


    // =========================
    // CART
    // =========================

    match /carts/{userId} {

      allow read, write: if isOwner(userId) || isAdmin();
    }


    // =========================
    // ADDRESSES
    // =========================

    match /addresses/{addressId} {

      // Existing address
      allow read, update, delete: if isSignedIn()
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
        );

      // New address
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
    }


    // =========================
    // ORDERS
    // =========================

    match /orders/{orderId} {

      // Customer अपना order देख सकता है.
      // Admin सभी orders देख सकता है.
      // Assigned courier अपना assigned order देख सकता है.
      allow read: if isAdmin()
        || (
          isSignedIn()
          && (
            resource.data.customerId == request.auth.uid
            || resource.data.userId == request.auth.uid
            || resource.data.courierId == request.auth.uid
          )
        );

      // Customer केवल अपने नाम से order create कर सकता है.
      allow create: if isSignedIn()
        && (
          request.resource.data.customerId == request.auth.uid
          || request.resource.data.userId == request.auth.uid
        );

      // Order status/admin changes केवल Admin या assigned Courier.
      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.courierId == request.auth.uid
        );

      // Orders delete केवल Admin.
      allow delete: if isAdmin();
    }


    // =========================
    // COURIERS
    // =========================

    match /couriers/{courierId} {

      // Courier अपना document देख सकता है.
      // Admin सभी courier documents देख सकता है.
      allow read: if isAdmin() || isOwner(courierId);

      // Courier registration/document submission के लिए
      // अपना document बना सकता है.
      allow create: if isOwner(courierId)
        && request.resource.data.uid == courierId;

      // Admin courier को approve/reject कर सकता है.
      // Courier अपना document update कर सकता है.
      allow update: if isAdmin()
        || (
          isOwner(courierId)
          && request.resource.data.uid == resource.data.uid
        );

      // Courier खुद अपना record delete नहीं कर सकता.
      allow delete: if isAdmin();
    }


    // =========================
    // DENY EVERYTHING ELSE
    // =========================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
