rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {

    // ============================================================
    // ADMIN
    // ============================================================

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "RkjeRGOd1xdCNFjVR7bB7GXtmAG2";
    }


    // ============================================================
    // SIGNED IN
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }


    // ============================================================
    // VENDOR DOCUMENTS
    // ============================================================

    match /vendor_documents/{userId}/{fileName} {

      // Admin has full access
      allow read, write: if isAdmin();


      // ----------------------------------------------------------
      // Vendor can READ own documents while pending/inactive
      // ----------------------------------------------------------

      allow read: if isSignedIn()
        && request.auth.uid == userId
        && firestore.exists(
          /databases/(default)/documents/users/$(userId)
        )
        && firestore.get(
          /databases/(default)/documents/users/$(userId)
        ).data.role == "vendor"
        && firestore.get(
          /databases/(default)/documents/users/$(userId)
        ).data.active == false
        && firestore.get(
          /databases/(default)/documents/users/$(userId)
        ).data.status != "approved";


      // ----------------------------------------------------------
      // Vendor can UPLOAD own documents while pending/inactive
      // ----------------------------------------------------------

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && firestore.exists(
          /databases/(default)/documents/users/$(userId)
        )
        && firestore.get(
          /databases/(default)/documents/users/$(userId)
        ).data.role == "vendor"
        && firestore.get(
          /databases/(default)/documents/users/$(userId)
        ).data.active == false
        && firestore.get(
          /databases/(default)/documents/users/$(userId)
        ).data.status != "approved"
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');


      // ----------------------------------------------------------
      // Vendor can UPDATE own documents while pending/inactive
      // ----------------------------------------------------------

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && firestore.exists(
          /databases/(default)/documents/users/$(userId)
        )
        && firestore.get(
          /databases/(default)/documents/users/$(userId)
        ).data.role == "vendor"
        && firestore.get(
          /databases/(default)/documents/users/$(userId)
        ).data.active == false
        && firestore.get(
          /databases/(default)/documents/users/$(userId)
        ).data.status != "approved"
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');


      // ----------------------------------------------------------
      // Vendor can DELETE own pending documents
      // ----------------------------------------------------------

      allow delete: if isSignedIn()
        && request.auth.uid == userId
        && firestore.exists(
          /databases/(default)/documents/users/$(userId)
        )
        && firestore.get(
          /databases/(default)/documents/users/$(userId)
        ).data.role == "vendor"
        && firestore.get(
          /databases/(default)/documents/users/$(userId)
        ).data.active == false
        && firestore.get(
          /databases/(default)/documents/users/$(userId)
        ).data.status != "approved";
    }


    // ============================================================
    // COURIER DOCUMENTS
    // ============================================================

    match /courier_documents/{userId}/{fileName} {

      // Admin has full access
      allow read, write: if isAdmin();


      // ----------------------------------------------------------
      // Courier can READ own documents while pending/inactive
      // ----------------------------------------------------------

      allow read: if isSignedIn()
        && request.auth.uid == userId
        && firestore.exists(
          /databases/(default)/documents/users/$(userId)
        )
        && firestore.get(
          /databases/(default)/documents/users/$(userId)
        ).data.role == "courier"
        && firestore.get(
          /databases/(default)/documents/users/$(userId)
        ).data.active == false
        && firestore.get(
          /databases/(default)/documents/users/$(userId)
        ).data.status != "approved";


      // ----------------------------------------------------------
      // Courier can UPLOAD own documents while pending/inactive
      // ----------------------------------------------------------

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && firestore.exists(
          /databases/(default)/documents/users/$(userId)
        )
        && firestore.get(
          /databases/(default)/documents/users/$(userId)
        ).data.role == "courier"
        && firestore.get(
          /databases/(default)/documents/users/$(userId)
        ).data.active == false
        && firestore.get(
          /databases/(default)/documents/users/$(userId)
        ).data.status != "approved"
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');


      // ----------------------------------------------------------
      // Courier can UPDATE own documents while pending/inactive
      // ----------------------------------------------------------

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && firestore.exists(
          /databases/(default)/documents/users/$(userId)
        )
        && firestore.get(
          /databases/(default)/documents/users/$(userId)
        ).data.role == "courier"
        && firestore.get(
          /databases/(default)/documents/users/$(userId)
        ).data.active == false
        && firestore.get(
          /databases/(default)/documents/users/$(userId)
        ).data.status != "approved"
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');


      // ----------------------------------------------------------
      // Courier can DELETE own pending documents
      // ----------------------------------------------------------

      allow delete: if isSignedIn()
        && request.auth.uid == userId
        && firestore.exists(
          /databases/(default)/documents/users/$(userId)
        )
        && firestore.get(
          /databases/(default)/documents/users/$(userId)
        ).data.role == "courier"
        && firestore.get(
          /databases/(default)/documents/users/$(userId)
        ).data.active == false
        && firestore.get(
          /databases/(default)/documents/users/$(userId)
        ).data.status != "approved";
    }


    // ============================================================
    // DENY EVERYTHING ELSE
    // ============================================================

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
