rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {

    // ============================================================
    // ADMIN
    // ============================================================

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "RkjeRGOd1xdCNFjVR7bB7GXtmAG2";
    }


    // ============================================================
    // SIGNED IN
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }


    // ============================================================
    // VENDOR DOCUMENTS
    // ============================================================

    match /vendor_documents/{userId}/{fileName} {

      // ----------------------------------------------------------
      // ADMIN
      // ----------------------------------------------------------

      allow read, write: if isAdmin();


      // ----------------------------------------------------------
      // VENDOR OWN DOCUMENTS
      // ----------------------------------------------------------
      // Only the owner can access documents while the vendor is
      // pending/rejected/inactive.
      // ----------------------------------------------------------

      function canManageVendorDocuments() {
        return isSignedIn()
          && request.auth.uid == userId
          && firestore.exists(
            /databases/(default)/documents/users/$(userId)
          )
          && firestore.get(
            /databases/(default)/documents/users/$(userId)
          ).data.role == "vendor"
          && firestore.get(
            /databases/(default)/documents/users/$(userId)
          ).data.active == false
          && firestore.get(
            /databases/(default)/documents/users/$(userId)
          ).data.approvedByAdmin == false
          && firestore.get(
            /databases/(default)/documents/users/$(userId)
          ).data.status != "approved";
      }


      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------

      allow read: if canManageVendorDocuments();


      // ----------------------------------------------------------
      // CREATE / UPLOAD
      // ----------------------------------------------------------

      allow create: if canManageVendorDocuments()
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');


      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------

      allow update: if canManageVendorDocuments()
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');


      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------

      allow delete: if canManageVendorDocuments();
    }


    // ============================================================
    // COURIER DOCUMENTS
    // ============================================================

    match /courier_documents/{userId}/{fileName} {

      // ----------------------------------------------------------
      // ADMIN
      // ----------------------------------------------------------
      // Admin can view/download/replace/delete courier documents.
      // ----------------------------------------------------------

      allow read, write: if isAdmin();


      // ----------------------------------------------------------
      // COURIER OWN DOCUMENTS
      // ----------------------------------------------------------

      function canManageCourierDocuments() {
        return isSignedIn()
          && request.auth.uid == userId
          && firestore.exists(
            /databases/(default)/documents/users/$(userId)
          )
          && firestore.get(
            /databases/(default)/documents/users/$(userId)
          ).data.role == "courier"
          && firestore.get(
            /databases/(default)/documents/users/$(userId)
          ).data.active == false
          && firestore.get(
            /databases/(default)/documents/users/$(userId)
          ).data.approvedByAdmin == false
          && firestore.get(
            /databases/(default)/documents/users/$(userId)
          ).data.status != "approved";
      }


      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------
      // Courier can see his own documents while registration is
      // pending/rejected.
      // ----------------------------------------------------------

      allow read: if canManageCourierDocuments();


      // ----------------------------------------------------------
      // CREATE / UPLOAD
      // ----------------------------------------------------------

      allow create: if canManageCourierDocuments()
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');


      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------

      allow update: if canManageCourierDocuments()
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');


      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------

      allow delete: if canManageCourierDocuments();
    }


    // ============================================================
    // DENY EVERYTHING ELSE
    // ============================================================

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
